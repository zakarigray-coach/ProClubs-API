DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Club website login uses the same Discord application, but requires its OAuth2 client secret.
# Set the redirect URI in the Discord Developer Portal to
# CLUB_SITE_BASE_URL/auth/discord/callback (exact match, HTTPS in production).
DISCORD_CLIENT_SECRET=
CLUB_SITE_BASE_URL=
CLUB_SITE_SESSION_SECRET=
# Add your Discord server ID while testing so slash commands appear immediately.
DISCORD_GUILD_ID=

# Required for automatic recap reading, article writing, and fresh hero artwork.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=medium
PORT=3000

# Discord user IDs used for private approvals and Tru's saved quote shortcut.
BOT_OWNER_ID=
TRU_USER_ID=
TRAP_USER_ID=764509653190180874

# Newspaper dates use Eastern Time by default. A signing quote stays open 12 hours.
NEWS_TIMEZONE=America/New_York
FC_SEASON=FC27
QUOTE_WAIT_HOURS=12
APPROVAL_WAIT_HOURS=48

# On Railway, attach a persistent volume at /data and set this to /data.
RT_DATA_DIR=.data

# Direct public image URL for the RT Football Media logo used in Discord embeds.
RT_MEDIA_LOGO_URL=

# Optional override. Railway installs ffmpeg through nixpacks.toml.
FFMPEG_PATH=ffmpeg

# Targeted Discord role alerts for reporter posts.
BIRMINGHAM_ROLE_ID=
MLPC_ROLE_ID=
# Preferred stable ID for the role titled Vice President of Football Operations.
FOOTBALL_OPS_ROLE_ID=1536963624747143199

# Optional explicit audit policy. Comma-separated Discord IDs, not display names.
# Existing BIRMINGHAM_ROLE_ID, MLPC_ROLE_ID and BOT_OWNER_ID are reused.
AUDITOR_MANAGEMENT_ROLE_IDS=
AUDITOR_MANAGEMENT_CATEGORY_IDS=
AUDITOR_BIRMINGHAM_CATEGORY_IDS=
AUDITOR_CROWNFC_CATEGORY_IDS=
AUDITOR_PROTECTED_CHANNEL_IDS=
