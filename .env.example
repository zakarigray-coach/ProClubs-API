# Set these as Railway variables. Never commit real values.

# Discord
GAFFER_DISCORD_TOKEN=
RT_MEDIA_DISCORD_TOKEN=
RT_MEDIA_PUBLISH_CHANNEL_ID=
OWNER_DISCORD_USER_ID=
GAFFER_GUILD_ID=
# Optional: comma-separated role IDs allowed to use the commands.
GAFFER_MANAGEMENT_ROLE_IDS=

# Storage. On Railway, attach a volume at /data.
GAFFER_DATABASE_PATH=/data/gaffergpt.db

# AI. Runs only when Coach asks for something.
PEP_COACH_API_KEY=
PEP_AI_MODEL=gpt-6-luna
# low, medium, high, xhigh or max
PEP_AI_EFFORT=max
PEP_AI_MAX_OUTPUT_TOKENS=32000
PEP_AI_TIMEOUT_SECONDS=300
# Optional per-job overrides: COACH (live advice), RECAP (reading results), REPORTER (articles).
# PEP_COACH_EFFORT=medium
# PEP_REPORTER_MODEL=gpt-6-sol
