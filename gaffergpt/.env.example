# A separate GafferGPT Discord application. Never reuse the live RT bot token.
GAFFER_DISCORD_TOKEN=
OWNER_DISCORD_USER_ID=
GAFFER_GUILD_ID=
# Configure these here, or run /configuregaffer once in Discord.
OURPROCLUBS_CHANNEL_ID=
OURPROCLUBS_BOT_ID=
GAFFER_MANAGEMENT_ROLE_IDS=
# Railway: attach a persistent volume at /data and use this path.
GAFFER_DATABASE_PATH=/data/gaffergpt.db
# Enable only after the private /testweeklydm delivery check passes.
PEP_FRIDAY_RECAP=false

# Optional first-run owner player name; does not replace an existing link.
PEP_OWNER_PLAYER_NAME=

# Private read-only RT bridge (separate from Discord token).
PEP_REPORTER_TOKEN=
PEP_REPORTER_PORT=8080
